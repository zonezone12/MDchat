# Copy this file to .env and fill in your API key.
# .env is git-ignored and never committed.

# LLM backend: anthropic (default) or gemini
# MDCHAT_PROVIDER=anthropic

ANTHROPIC_API_KEY=sk-ant-api03-your-key-here

# For Gemini (google-genai): pip install -e ".[chat,gemini]"
# GEMINI_API_KEY=your-google-ai-studio-key
# (GOOGLE_API_KEY is also accepted)

# Optional: model id for the active provider
# MDCHAT_MODEL=claude-sonnet-4-20250514
# MDCHAT_MODEL=gemini-2.0-flash

# Optional: directory for output plots/CSVs (default: temp dir)
# MDCHAT_OUTPUT_DIR=./output
