# Copy this file to .env and fill in your API key.
# .env is git-ignored and never committed.

# LLM backend: anthropic (default) or gemini
# MDCHAT_PROVIDER=anthropic

ANTHROPIC_API_KEY=sk-ant-api03-your-key-here

# For Gemini (google-genai): pip install -e ".[chat,gemini]"
# GEMINI_API_KEY=your-google-ai-studio-key
# (GOOGLE_API_KEY is also accepted)

# Optional: model id for the active provider
# MDCHAT_MODEL=claude-sonnet-4-20250514
# MDCHAT_MODEL=gemini-2.5-flash

# Optional: comma-separated list for /model picker (must match active MDCHAT_PROVIDER)
# MDCHAT_MODEL_CHOICES=claude-haiku-4-20250514,claude-sonnet-4-20250514

# Optional: exact session directory for plots/CSVs (skill writes go here as-is).
# Omit or set to ./output to get dated folders: output/YYYY-MM-DD_mdchat-HHMMSS/
# MDCHAT_OUTPUT_DIR=./output
# Reuse the same folder to keep chat history: mdchat_conversation.json + mdchat_transcript.md

# Optional: append docs/mdchat-analysis-playbook.md to the LLM system prompt (more user-guidance tokens).
# MDCHAT_INCLUDE_PLAYBOOK=1
# Optional: custom playbook path instead of repo docs/mdchat-analysis-playbook.md
# MDCHAT_PLAYBOOK_PATH=/path/to/playbook.md
